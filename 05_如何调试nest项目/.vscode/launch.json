{
  "configurations": [
    {
      "name": "nest debug", // 自定义名称
      "request": "launch",
      "runtimeArgs": ["run", "start:dev"], // 和package.json的启动命令一样
      "runtimeExecutable": "npm",
      "skipFiles": ["<node_internals>/**"],
      "type": "node",
      "console": "integratedTerminal" // 指定console类型为integratedTerminal,也就是用VScode的内置终端来打印日志,不然默认会用debug console来跑,那个没有颜色.
    }
  ]
}
